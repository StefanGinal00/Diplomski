[node name="Seren" parent="." instance=ExtResource("3_resident")]
position = Vector2(310, 367)
resident_name = "Seren"
dialogue_lines = PackedStringArray("The lanterns burn all night here. No one has to cross the ward in darkness.", "The market is farther inside the Citadel. For now, we share what comes through the gate.")
route_marker_names = PackedStringArray("WestDoorway", "WestMeeting")
talk_partner = NodePath("../Ilya")
social_lines = PackedStringArray("Ilya, the lamps need oil before dusk.", "Another traveler made it safely through the gate.")
