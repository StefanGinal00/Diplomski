accent_color = Color(0.93, 0.78, 0.53, 1)
walk_speed = 22.0

[node name="Ilya" parent="." instance=ExtResource("3_resident")]
position = Vector2(555, 367)
resident_name = "Ilya"
dialogue_lines = PackedStringArray("The watch calls this the Lantern Ward. Everyone knows everyone by the glow of their doorway.", "We had no smith for weeks. Aster set up a small anvil beside the supply stall.")
route_marker_names = PackedStringArray("EastMeeting", "WestMeeting", "EastDoorway")
talk_partner = NodePath("../Seren")
social_lines = PackedStringArray("I'll take the east row, Seren.", "The workshop is still open.")
coat_color = Color(0.32, 0.42, 0.52, 1)
accent_color = Color(0.72, 0.88, 0.84, 1)
walk_speed = 20.0

[node name="Vey" parent="." instance=ExtResource("3_resident")]
position = Vector2(1075, 367)
