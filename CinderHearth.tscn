[node name="Dara" parent="." instance=ExtResource("3_resident")]
position = Vector2(271, 357)
resident_name = "Dara"
dialogue_lines = PackedStringArray("We keep the hearth alive for travelers who make it through the Causeway.", "The old bells still ring when the vents wake. They have saved more lives than any blade.")
timeline_dialogue_stage = 4
timeline_dialogue_lines = PackedStringArray("A caravan came down from Starfall. They say the Citadel gates are open to travelers again.", "The hearth stays lit, even with the Castellan gone. There will always be someone coming home through the ash.")
coat_color = Color(0.46, 0.29, 0.28, 1)
accent_color = Color(0.94, 0.61, 0.34, 1)
route_marker_names = PackedStringArray("DaraConversationSpot", "DaraHearthDoorway", "DaraStreetCorner")
talk_partner = NodePath("../Bram")
social_lines = PackedStringArray("Bram, did the supply carts arrive?", "The hearth is warm. Stay for a moment.")
walk_speed = 24.0
pause_seconds = 2.2

[node name="Tarin" parent="." groups=["hearth_gate_quest_npc"] instance=ExtResource("3_resident")]
position = Vector2(210, 357)
resident_name = "Tarin"
dialogue_lines = PackedStringArray("The lanterns stop at the gate. Keep your blade ready beyond them.", "Our guards can hold the wall, but the road needs someone who can fight out there.")
coat_color = Color(0.34, 0.31, 0.4, 1)
accent_color = Color(0.96, 0.68, 0.36, 1)

[node name="Bram" parent="." instance=ExtResource("3_resident")]
position = Vector2(427, 357)
resident_name = "Bram"
dialogue_lines = PackedStringArray("The Bastion was a fortress once. Now its walls keep us warm.", "Past the gate, the ash belongs to the fiends. In here, you can breathe.")
coat_color = Color(0.37, 0.34, 0.38, 1)
accent_color = Color(0.77, 0.69, 0.54, 1)
route_marker_names = PackedStringArray("BramConversationSpot", "BramMarketDoorway", "BramStreetCorner")
talk_partner = NodePath("../Dara")
social_lines = PackedStringArray("A little late, Dara. The road was quiet at least.", "I'll take the next watch by the gate.")
walk_speed = 22.0
pause_seconds = 5.0

[node name="Mira" parent="." groups=["hearth_quest_npc"] instance=ExtResource("3_resident")]
position = Vector2(747, 357)
resident_name = "Mira"
dialogue_lines = PackedStringArray("Our smith says every scar in a blade tells a story. I prefer stories with happy endings.", "If you find more emberstone, bring it home. We can make the next crossing safer.")
coat_color = Color(0.43, 0.29, 0.34, 1)
accent_color = Color(0.96, 0.69, 0.43, 1)

[node name="Oren" parent="." instance=ExtResource("3_resident")]
position = Vector2(1082, 357)
resident_name = "Oren"
dialogue_lines = PackedStringArray("I was born in this little street. Some nights I almost forget the war outside.", "We leave a bowl by the gate for those who come home late.")
timeline_dialogue_stage = 4
timeline_dialogue_lines = PackedStringArray("My brother wrote from Starfall Citadel. He says the city has streets above the streets.", "The supply road is open again, but we still leave a bowl by the gate for late travelers.")
coat_color = Color(0.3, 0.36, 0.39, 1)
accent_color = Color(0.77, 0.77, 0.6, 1)
route_marker_names = PackedStringArray("OrenSmithyDoorway", "OrenEastSquare", "OrenGateWalk")
social_lines = PackedStringArray("The smithy's fire is still burning.", "Keep the path clear for travelers.")
walk_speed = 20.0
pause_seconds = 2.6

