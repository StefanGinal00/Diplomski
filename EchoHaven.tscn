service_name = "Nalim's Glowmarket"
service_color = Color(0.39, 0.86, 0.71, 1)

[node name="Ivara" parent="." instance=ExtResource("3_resident")]
position = Vector2(760, 129)
resident_name = "Ivara"
dialogue_lines = PackedStringArray("The people above us call this place a ruin. They have never seen it lit at night.", "The Matriarch guarded the deep halls. Whatever comes after her still frightens me.")
timeline_dialogue_stage = 3
timeline_dialogue_lines = PackedStringArray("The Matriarch is gone, but the road into the Bastion has opened. That is not the end of our worries.", "Travelers from Cinder Hearth have begun trading here again. Perhaps these halls can be a home, not a refuge.")
coat_color = Color(0.41, 0.3, 0.44, 1)
accent_color = Color(0.78, 0.65, 0.87, 1)
route_marker_names = PackedStringArray("EastGatheringIvara", "MarketDoor", "EastGatheringIvara", "RightHomeDoor")
talk_partner = NodePath("../Vey")
social_lines = PackedStringArray("Vey, the newcomers made it back safely.", "One day this whole cavern may be bright again.")
walk_speed = 26.0
pause_seconds = 5.0

[node name="CrystalAnvil" parent="." instance=ExtResource("4_service")]
