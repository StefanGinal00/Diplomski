[node name="Neris" parent="." instance=ExtResource("3_resident")]
position = Vector2(245, 129)
resident_name = "Neris"
dialogue_lines = PackedStringArray("The crystals hum differently when both resonators are awake.", "My mother taught me to listen for the quiet notes. They mean the path is safe.")
timeline_dialogue_stage = 3
timeline_dialogue_lines = PackedStringArray("Word reached us that someone crossed into the Ashen Bastion. Even the crystals sound restless tonight.", "Calen is drawing a safe route for anyone returning from the ash. I keep the lamp burning for them.")
coat_color = Color(0.26, 0.41, 0.54, 1)
accent_color = Color(0.44, 0.86, 0.81, 1)
route_marker_names = PackedStringArray("WestGatheringNeris", "LeftHomeDoor", "WestGatheringNeris", "MarketDoor")
talk_partner = NodePath("../Calen")
social_lines = PackedStringArray("Calen, did you hear the bright crystals singing again?", "I left a lantern burning for everyone coming home.")
walk_speed = 32.0
pause_seconds = 4.0

[node name="LyraSurveyor" parent="." instance=ExtResource("5_lyra")]
position = Vector2(350, 129)

[node name="Calen" parent="." instance=ExtResource("3_resident")]
position = Vector2(450, 129)
resident_name = "Calen"
dialogue_lines = PackedStringArray("We used to trade stories by the lamp. Now we trade routes through the dark.", "If a passage grows too dangerous, there is no shame in coming home to rest.")
coat_color = Color(0.38, 0.36, 0.52, 1)
accent_color = Color(0.6, 0.75, 0.91, 1)
route_marker_names = PackedStringArray("WestGatheringCalen", "MarketDoor", "WestGatheringCalen", "LeftHomeDoor")
talk_partner = NodePath("../Neris")
social_lines = PackedStringArray("The glowing path is clear tonight, Neris.", "The market is quiet. Let's keep it that way.")
walk_speed = 27.0
pause_seconds = 5.5

[node name="GlowmarketTrader" parent="." instance=ExtResource("4_service")]
position = Vector2(590, 129)
service_kind = "shop"
