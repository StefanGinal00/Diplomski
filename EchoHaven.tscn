[node name="Vey" parent="." instance=ExtResource("3_resident")]
position = Vector2(990, 129)
resident_name = "Vey"
dialogue_lines = PackedStringArray("No one here asks you to be a hero. You can sit with us for a while.", "The Grotto remembers every footstep. I hope it remembers yours kindly.")
