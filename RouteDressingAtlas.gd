# Opaque terminal pixels in original, cropped hanging-root artwork (variants
# 3/4). Registered by audit_route_drip_sources.gd; no runtime image readback.
const DRIP_TIPS := {"cave":[Vector2(119,599),Vector2(142,583)],"mine":[Vector2(119,514),Vector2(94,537)],"ash":[Vector2(129,524),Vector2(94,521)],"star":[Vector2(83,569),Vector2(128,577)]}
static var cache := {}

static func drip_tip(family: String, index: int) -> Vector2:
	var sheet := "route_%s_ceiling_v1"%family
	var entry: Dictionary = DATA[sheet]
	var ratio := texture(sheet,index).atlas.get_size()/Vector2(entry.size[0],entry.size[1])
	return (DRIP_TIPS[family][index-3]+Vector2(.5,.5))*ratio

static func texture(sheet: String, index: int) -> AtlasTexture:
	var key := sheet + str(index)
	if cache.has(key): return cache[key]
	var entry: Dictionary = DATA[sheet]
	var b: Array = entry.boxes[index]
	var source: Texture2D = load("res://art/visual_slice/%s.png"%sheet)
	var ratio := source.get_size()/Vector2(entry.size[0],entry.size[1])
	var atlas := AtlasTexture.new()
	atlas.atlas = source
	atlas.region = Rect2(Vector2(b[0],b[1])*ratio,Vector2(b[2],b[3])*ratio)
	atlas.filter_clip = true
	cache[key] = atlas
	return atlas

static func contact(sheet: String, index: int, ceiling: bool) -> float:
	var entry: Dictionary = DATA[sheet]
	return float(entry.contacts[index][0 if ceiling else 1])*texture(sheet,index).atlas.get_height()/entry.size[1]
