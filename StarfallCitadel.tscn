[node name="Nima" parent="." instance=ExtResource("5_resident")]
position = Vector2(4870, 367)
resident_name = "Nima"
dialogue_lines = PackedStringArray("The garden is ours to tend, not to lock away.", "There are no monsters inside these walls. Even the high walkways are safe.")
victory_dialogue_lines = PackedStringArray("The new light reached the garden before dawn. The roots are already turning toward it.", "The world beyond these walls still needs tending. No crown can do that for us.")
