[node name="Rook" parent="." groups=["starfall_route_npc"] instance=ExtResource("5_resident")]
position = Vector2(1330, 367)
resident_name = "Rook"
dialogue_lines = PackedStringArray("The gate is behind us, but the city keeps going long after this street.", "I deliver letters from the watch to every house before nightfall.")
route_marker_names = PackedStringArray("LinkDoorway", "LinkStreet")
social_lines = PackedStringArray("The ward is waking up.", "One more letter for the east row.")
coat_color = Color(0.36, 0.42, 0.54, 1)
accent_color = Color(0.94, 0.79, 0.54, 1)
walk_speed = 25.0

[node name="Liora" parent="." instance=ExtResource("5_resident")]
position = Vector2(1600, 127)
resident_name = "Liora"
dialogue_lines = PackedStringArray("From this walk you can see the lanterns all the way to the market.", "The upper streets are quiet, but they connect back to the lower city.")
victory_dialogue_lines = PackedStringArray("The watch lights changed when the throne went quiet. I saw it from this rail.", "For once the far road looks like a road, not a warning.")
route_marker_names = PackedStringArray("PromenadeWest", "PromenadeEast")
talk_partner = NodePath("../Kel")
social_lines = PackedStringArray("Kel, did you count the market lamps?", "The west rail needs another coat of paint.")
victory_social_lines = PackedStringArray("Kel, the far lamps are answering ours.", "People are walking the upper road again.")
coat_color = Color(0.4, 0.4, 0.59, 1)
accent_color = Color(0.76, 0.85, 0.98, 1)
walk_speed = 20.0

[node name="Kel" parent="." instance=ExtResource("5_resident")]
position = Vector2(1940, 127)
resident_name = "Kel"
dialogue_lines = PackedStringArray("I came up here for the view and stayed for the peace.", "You can drop to the street or take the steps down at the far end.")
victory_dialogue_lines = PackedStringArray("I thought the sky above the throne would stay dark forever.", "Liora says the watch can see every lantern on the road now.")
route_marker_names = PackedStringArray("PromenadeEast", "PromenadeWest")
social_lines = PackedStringArray("All the lamps are lit, Liora.", "The market is louder than the watch tonight.")
victory_social_lines = PackedStringArray("I counted them. Not one has gone out.", "The watch can breathe tonight.")
coat_color = Color(0.4, 0.5, 0.53, 1)
accent_color = Color(0.89, 0.77, 0.65, 1)
walk_speed = 18.0

[node name="Osric" parent="." instance=ExtResource("5_resident")]
position = Vector2(3150, 367)
resident_name = "Osric"
dialogue_lines = PackedStringArray("The market trades more stories than goods on quiet days.", "Our hall stays open to travelers, even when the stalls close.")
victory_dialogue_lines = PackedStringArray("The square has spent years waiting for news from the throne. Now everyone has a different version.", "The hall is open. Let the travelers tell us what really happened.")
route_marker_names = PackedStringArray("MarketStreetWest", "MarketHallDoorway")
talk_partner = NodePath("../Cera")
social_lines = PackedStringArray("Cera, any news from the observatory?", "The west stall is running low again.")
victory_social_lines = PackedStringArray("Cera, make room for the returning watch.", "There is a celebration to stock for.")
coat_color = Color(0.46, 0.34, 0.43, 1)
accent_color = Color(0.95, 0.7, 0.58, 1)
walk_speed = 22.0

[node name="Cera" parent="." instance=ExtResource("5_resident")]
position = Vector2(3470, 367)
resident_name = "Cera"
dialogue_lines = PackedStringArray("Each stall depends on the next caravan. We make the supplies last until it arrives.", "The balcony above the hall hides a little supply chest.")
victory_dialogue_lines = PackedStringArray("The caravans may finally use the eastern road without an escort.", "I am keeping the stalls open late. We have a city to welcome back.")
route_marker_names = PackedStringArray("MarketStreetEast", "MarketStreetWest", "MarketHallDoorway")
social_lines = PackedStringArray("The garden lamps are bright tonight.", "Osric, save a place at the hall table.")
victory_social_lines = PackedStringArray("Osric, the road traders are already here.", "Save them a place by the hearth.")
coat_color = Color(0.46, 0.4, 0.52, 1)
accent_color = Color(0.98, 0.81, 0.62, 1)
walk_speed = 20.0

