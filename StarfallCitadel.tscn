[node name="Atley" parent="." groups=["dawn_archive_npc"] instance=ExtResource("5_resident")]
position = Vector2(4460, 367)
resident_name = "Atley"
dialogue_lines = PackedStringArray("The library keeps records of every caravan that found the Citadel.", "I walk between the shelves and the garden when the square grows too loud.")
victory_dialogue_lines = PackedStringArray("Our records end at the sealed throne. Tomorrow I start a new volume.", "Three memories opened that door. We should write down whose hands kept them safe.")
